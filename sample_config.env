# ===============================================
#      AdvancedMergeBot Configuration File
# ===============================================

# 🤖 BOT CONFIGURATION (Required)
# Get these from https://my.telegram.org/apps
API_HASH=your_api_hash_here
TELEGRAM_API=your_api_id_here
BOT_TOKEN=your_bot_token_from_botfather

# 👤 OWNER CONFIGURATION (Required)
OWNER=your_telegram_user_id
OWNER_USERNAME=your_telegram_username
PASSWORD=your_bot_access_password

# 🗄️ DATABASE CONFIGURATION (Required)
# MongoDB connection string
DATABASE_URL=mongodb://username:password@host:port/database_name
# Example: mongodb://admin:password123@localhost:27017/mergebot

# 📋 LOGGING CONFIGURATION (Optional)
# Telegram channel ID for logs (use negative ID)
LOGCHANNEL=-100xxxxxxxxxx

# ☁️ CLOUD STORAGE CONFIGURATION (Optional)
# GoFile API token for uploads (leave empty for anonymous)
GOFILE_TOKEN=your_gofile_token_here

# 🔧 ADVANCED CONFIGURATION (Optional)
# Maximum file size in bytes (default: 2GB)
MAX_FILE_SIZE=2147483648

# Download chunk size in bytes (default: 8MB)
DOWNLOAD_CHUNK_SIZE=8388608

# Upload chunk size in bytes (default: 10MB)
UPLOAD_CHUNK_SIZE=10485760

# Progress update throttle in seconds (default: 2.0)
EDIT_THROTTLE_SECONDS=2.0

# Maximum concurrent merges (default: 3)
MAX_CONCURRENT_MERGES=3

# Auto-delete source files after merge (default: false)
AUTO_DELETE_SOURCE=false

# Default merge quality (high/medium/low)
DEFAULT_QUALITY=high

# Enable premium features (true/false)
ENABLE_PREMIUM_FEATURES=false

# ===============================================
#              SETUP INSTRUCTIONS
# ===============================================

# 1. BOT TOKEN:
#    - Message @BotFather on Telegram
#    - Create new bot with /newbot
#    - Copy the token to BOT_TOKEN

# 2. API CREDENTIALS:
#    - Go to https://my.telegram.org/apps
#    - Create new application
#    - Copy API ID to TELEGRAM_API
#    - Copy API Hash to API_HASH

# 3. OWNER INFO:
#    - Message @userinfobot to get your user ID
#    - Set your username without @
#    - Choose a strong password

# 4. DATABASE:
#    - Set up MongoDB database
#    - Use connection string format
#    - For local: mongodb://localhost:27017/mergebot

# 5. OPTIONAL FEATURES:
#    - Get GoFile token from https://gofile.io
#    - Create log channel and add bot as admin
#    - Use negative channel ID with -100 prefix

# ===============================================
#                   EXAMPLES
# ===============================================

# Example with all required fields:
# API_HASH=1234567890abcdef1234567890abcdef
# TELEGRAM_API=12345678
# BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
# OWNER=987654321
# OWNER_USERNAME=your_username
# PASSWORD=MySecretPassword123
# DATABASE_URL=mongodb://admin:password@localhost:27017/mergebot

# Example with MongoDB Atlas (cloud):
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/mergebot?retryWrites=true&w=majority

# Example with all optional features:
# LOGCHANNEL=-1001234567890
# GOFILE_TOKEN=abc123def456ghi789
# MAX_FILE_SIZE=4294967296
# AUTO_DELETE_SOURCE=true
# DEFAULT_QUALITY=high
# ENABLE_PREMIUM_FEATURES=true

# ===============================================
#                   SECURITY NOTES
# ===============================================

# ⚠️  IMPORTANT SECURITY TIPS:
# - Never share this file publicly
# - Use strong passwords
# - Keep your tokens secret
# - Use environment variables in production
# - Enable 2FA on your Telegram account
# - Regularly rotate your bot token if compromised

# 🔒 PRODUCTION DEPLOYMENT:
# - Rename this file to .env or config.env
# - Add to .gitignore to avoid accidental commits
# - Use Docker secrets or cloud environment variables
# - Set appropriate file permissions (chmod 600)

# ===============================================
#                 TROUBLESHOOTING
# ===============================================

# Common Issues:
# 1. "Invalid bot token" → Check BOT_TOKEN format
# 2. "Database connection failed" → Verify DATABASE_URL
# 3. "Access denied" → Check OWNER user ID
# 4. "API rate limit" → Reduce EDIT_THROTTLE_SECONDS
# 5. "File too large" → Increase MAX_FILE_SIZE

# Support:
# - Check logs in /logs directory
# - Test connection with /start command
# - Verify FFmpeg installation
# - Check file permissions

# ===============================================
