# sample_config.env - Complete configuration template

# ========================
# 🤖 BOT CONFIGURATION (REQUIRED)
# ========================

# Get from https://my.telegram.org
API_HASH=your_api_hash_here
TELEGRAM_API=your_api_id_here

# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get from @userinfobot)
OWNER=your_user_id_here

# Your Telegram Username (without @)
OWNER_USERNAME=your_username_here

# Bot access password (optional)
PASSWORD=your_bot_password_here

# ========================
# 🗄️ DATABASE CONFIGURATION
# ========================

# MongoDB connection string
# Local: mongodb://localhost:27017/mergebot
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/mergebot
DATABASE_URL=mongodb://localhost:27017/mergebot

# Telegram channel ID for logs (optional)
LOGCHANNEL=-1001234567890

# ========================
# 📤 UPLOAD CONFIGURATION
# ========================

# GoFile API Token (optional, get from gofile.io)
GOFILE_TOKEN=your_gofile_token_here

# ========================
# ⚙️ ADVANCED SETTINGS (OPTIONAL)
# ========================

# Maximum file size in bytes (default: 2GB)
MAX_FILE_SIZE=2147483648

# Download chunk size in bytes (default: 10MB)
CHUNK_SIZE=10485760

# Maximum files to merge at once (default: 20)
MAX_MERGE_FILES=20

# Progress update interval in seconds (default: 2.0)
EDIT_THROTTLE_SECONDS=2.0

# Default merge quality (high/medium/low)
DEFAULT_QUALITY=high

# Enable premium features (true/false)
IS_PREMIUM=false

# ========================
# 📁 DIRECTORY CONFIGURATION (AUTO-CREATED)
# ========================

# Download directory (default: downloads)
DOWNLOAD_DIR=downloads

# Temporary directory (default: temp)
TEMP_DIR=temp

# User data directory (default: userdata)
USERDATA_DIR=userdata

# ========================
# 🔧 SYSTEM CONFIGURATION
# ========================

# FFmpeg binary path (leave empty for system PATH)
FFMPEG_PATH=

# Maximum concurrent processes (default: 5)
MAX_CONCURRENT_PROCESSES=5

# Enable debug logging (true/false)
DEBUG_MODE=false

# ========================
# 🛡️ SECURITY SETTINGS
# ========================

# Allowed file extensions (comma-separated)
ALLOWED_VIDEO_EXTENSIONS=mp4,mkv,avi,webm,mov,flv,wmv,m4v,ts
ALLOWED_AUDIO_EXTENSIONS=mp3,aac,wav,flac,m4a,ogg,wma,ac3,dts
ALLOWED_SUBTITLE_EXTENSIONS=srt,ass,vtt,sub,ssa,idx,sup

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Ban duration in hours (default: 24)
BAN_DURATION=24

# ========================
# 📊 ANALYTICS (OPTIONAL)
# ========================

# Google Analytics tracking ID
GA_TRACKING_ID=

# Enable usage analytics (true/false)
ENABLE_ANALYTICS=false

# ========================
# 🔔 NOTIFICATIONS (OPTIONAL)
# ========================

# Webhook URL for notifications
WEBHOOK_URL=

# Email notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# ========================
# 🌐 DEPLOYMENT SETTINGS
# ========================

# Server port (for webhooks)
PORT=8080

# Server host
HOST=0.0.0.0

# Environment (development/production)
ENVIRONMENT=production

# Timezone
TIMEZONE=UTC

# ========================
# 💾 BACKUP SETTINGS
# ========================

# Automatic backup interval in hours (0 = disabled)
BACKUP_INTERVAL=24

# Backup storage path
BACKUP_PATH=backups

# Maximum backup files to keep
MAX_BACKUPS=7

# ========================
# INSTRUCTIONS
# ========================
# 1. Copy this file as 'config.env'
# 2. Fill in the required values (marked as REQUIRED)
# 3. Optional: Configure additional settings
# 4. Make sure MongoDB is running
# 5. Install FFmpeg on your system
# 6. Run: python bot.py
